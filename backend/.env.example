# Database
DATABASE_URL=sqlite:///./data/student_assistant.db

# JWT (change in production)
JWT_SECRET=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Optional: create admin via script (see README)

# LLM Provider (openai or groq)
LLM_PROVIDER=groq
LLM_API_KEY=your-api-key-here
# OpenAI example: gpt-4o-mini
# Groq example: openai/gpt-oss-20b
LLM_MODEL=openai/gpt-oss-20b
# OpenAI default: leave empty
# Groq: https://api.groq.com/openai/v1
LLM_BASE_URL=https://api.groq.com/openai/v1

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
USE_FAKE_EMBEDDINGS=false
VECTOR_STORE_DIRECTORY=./data/vector_store

# Intent classifier
INTENT_MODEL_PATH=./data/models/intent_classifier.joblib
INTENT_METRICS_PATH=./data/models/intent_metrics.json
INTENTS_DATASET_PATH=./training/intents.csv

# Retrieval
TOP_K=5
BROAD_QUERY_TOP_K=8
SIMILARITY_THRESHOLD=0.35
INTENT_CONFIDENCE_THRESHOLD=0.45
INTENT_CATEGORY_BOOST=0.05
HYBRID_KEYWORD_WEIGHT=0.15
CHAT_HISTORY_WINDOW=5
RAG_DEBUG=false

# File uploads
UPLOAD_DIRECTORY=./data/documents
PROCESSED_DIRECTORY=./data/processed
CHUNK_SIZE=500
CHUNK_OVERLAP=75
MAX_UPLOAD_SIZE_MB=15
ALLOWED_DOCUMENT_TYPES=pdf,txt,docx,csv

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# App
APP_NAME=College AI Student Assistant
DEBUG=true
